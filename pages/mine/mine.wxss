.page {
  padding-top: 20rpx;
}

/* ---------- 个人信息 ---------- */
.profile-card {
  display: flex;
  align-items: center;
  padding: 32rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f0f7ff 100%);
}
.avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  color: #fff;
  font-size: 48rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  box-shadow: 0 8rpx 22rpx rgba(47, 107, 255, 0.25);
  overflow: hidden;
}
.avatar-img {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
}
.phone-txt {
  font-size: 22rpx;
  color: #7b8799;
  margin-top: 10rpx;
}
.profile-main {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}
.nick-line {
  display: flex;
  align-items: center;
}
.nick {
  font-size: 36rpx;
  font-weight: 800;
  color: #16233c;
  max-width: 320rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.edit-btn {
  font-size: 22rpx;
  color: #2f6bff;
  margin-left: 16rpx;
  background: #eef4ff;
  padding: 6rpx 14rpx;
  border-radius: 20rpx;
}
.role-txt {
  font-size: 22rpx;
  color: #7b8799;
  margin-top: 10rpx;
}
.role-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.login-chip {
  font-size: 22rpx;
  color: #2f6bff;
  background: #eef4ff;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  margin-top: 10rpx;
  flex: none;
}
.edit-box {
  display: flex;
  align-items: center;
}
.nick-input {
  flex: 1;
  background: #f6f8fd;
  border-radius: 14rpx;
  height: 64rpx;
  padding: 0 18rpx;
  font-size: 28rpx;
}
.save-btn {
  color: #fff;
  background: linear-gradient(135deg, #4d86ff, #2f6bff);
  font-size: 24rpx;
  border-radius: 24rpx;
  padding: 10rpx 22rpx;
  margin-left: 12rpx;
}
.cancel-btn {
  color: #9aa3b5;
  font-size: 24rpx;
  margin-left: 12rpx;
  padding: 10rpx;
}
.level-badge {
  flex: none;
  font-size: 22rpx;
  color: #d97706;
  background: #fff7ec;
  border-radius: 24rpx;
  padding: 10rpx 16rpx;
  border: 2rpx solid rgba(217, 119, 6, 0.15);
}
.level-badge.on {
  color: #fff;
  background: linear-gradient(135deg, #ef6c00, #e53935);
  border-color: transparent;
}
.level-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 28rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, #fff7ec 0%, #ffeede 100%);
  border: 2rpx solid rgba(239,108,0,.15);
}
.lc-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #b4620a;
}
.lc-sub {
  font-size: 22rpx;
  color: #9a6b3f;
  margin-top: 8rpx;
  max-width: 480rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.lc-btn {
  flex: none;
  font-size: 24rpx;
  color: #ef6c00;
  font-weight: 700;
  margin-left: 16rpx;
}

/* ---------- 统计 ---------- */
.stats-card {
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.stats-head {
  display: flex;
  align-items: baseline;
}
.stats-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #16233c;
}
.stats-sub {
  font-size: 20rpx;
  color: #9aa3b5;
  margin-left: 14rpx;
}
.stats-grid {
  display: flex;
  margin-top: 24rpx;
  background: linear-gradient(160deg, #f6f9ff, #eefbf6);
  border-radius: 24rpx;
  padding: 24rpx 0;
}
.stat-item {
  flex: 1;
  text-align: center;
  position: relative;
}
.stat-item:not(:last-child)::after {
  content: '';
  position: absolute;
  right: 0;
  top: 12rpx;
  bottom: 12rpx;
  width: 2rpx;
  background: rgba(47, 107, 255, 0.12);
}
.stat-icon {
  font-size: 30rpx;
}
.stat-value {
  font-size: 44rpx;
  font-weight: 800;
  color: #16233c;
  margin-top: 6rpx;
  font-family: 'DIN Alternate', sans-serif;
}
.stat-label {
  font-size: 20rpx;
  color: #7b8799;
  margin-top: 4rpx;
}
.stats-extra {
  text-align: center;
  font-size: 22rpx;
  color: #06a86b;
  margin-top: 18rpx;
  background: #eefaf4;
  border-radius: 16rpx;
  padding: 12rpx;
}

.hot-box {
  margin-top: 22rpx;
}
.hot-title {
  font-size: 24rpx;
  color: #44506b;
  font-weight: 600;
  margin-bottom: 12rpx;
}
.hot-item {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 2rpx solid #f2f5fa;
}
.hot-item:last-child {
  border-bottom: none;
}
.hot-rank {
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  background: #eef1f8;
  color: #7b8799;
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
  line-height: 40rpx;
  margin-right: 16rpx;
  flex: none;
}
.hot-rank.first {
  background: linear-gradient(135deg, #ffd66e, #ff9f43);
  color: #fff;
}
.hot-name {
  flex: 1;
  font-size: 26rpx;
  color: #16233c;
}
.hot-count {
  font-size: 22rpx;
  color: #2f6bff;
  font-weight: 600;
}

/* ---------- 板块切换 ---------- */
.seg-bar {
  display: flex;
  padding: 8rpx;
  margin-bottom: 24rpx;
}
.seg {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #7b8799;
  line-height: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  transition: all .2s ease;
  display: flex;
  align-items: center;
  justify-content: center;
}
.seg.on {
  background: linear-gradient(135deg, #4d86ff, #2f6bff);
  color: #fff;
  font-weight: 600;
  box-shadow: 0 8rpx 18rpx rgba(47, 107, 255, 0.28);
}
.seg-num {
  background: rgba(255, 255, 255, 0.35);
  font-size: 20rpx;
  border-radius: 18rpx;
  padding: 0 12rpx;
  line-height: 32rpx;
  margin-left: 10rpx;
}
.seg:not(.on) .seg-num {
  background: #e6ecf8;
  color: #2f6bff;
}

/* ---------- 迷你卡片 ---------- */
.mini-card {
  padding: 26rpx;
  margin-bottom: 22rpx;
}
.mini-top {
  display: flex;
  align-items: center;
}
.m-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  flex: none;
  margin-right: 20rpx;
}
.m-info {
  flex: 1;
  min-width: 0;
}
.m-venue {
  font-size: 30rpx;
  font-weight: 700;
  color: #16233c;
}
.m-time {
  font-size: 22rpx;
  color: #7b8799;
  margin-top: 6rpx;
}
.m-join-time {
  font-size: 20rpx;
  color: #b3bccd;
  margin-top: 4rpx;
}
.m-status {
  flex: none;
  font-size: 20rpx;
  font-weight: 600;
  border-radius: 20rpx;
  padding: 8rpx 16rpx;
  margin-left: 12rpx;
}
.m-bell {
  flex: none;
  font-size: 20rpx;
  font-weight: 600;
  border-radius: 20rpx;
  padding: 8rpx 16rpx;
  margin-left: 12rpx;
  background: rgba(47, 107, 255, .12);
  color: #2f6bff;
}
.m-status.ok {
  background: rgba(15, 208, 131, 0.12);
  color: #06a86b;
}
.m-status.ok::before {
  content: '';
  display: inline-block;
  width: 8rpx;
  height: 8rpx;
  background: #0fd083;
  border-radius: 50%;
  margin-right: 6rpx;
  animation: blinkAnim 1.2s ease infinite;
}
.m-status.full {
  background: #eef1f8;
  color: #98a2b3;
}
.m-status.cancel {
  background: #fff0f1;
  color: #ff4d5a;
}
.m-status.end {
  background: #f2f4f8;
  color: #b3bccd;
}
.m-status.open {
  background: rgba(15, 208, 131, 0.12);
  color: #06a86b;
}
.m-status.open::before {
  content: '';
  display: inline-block;
  width: 8rpx;
  height: 8rpx;
  background: #0fd083;
  border-radius: 50%;
  margin-right: 6rpx;
  animation: blinkAnim 1.2s ease infinite;
}
.m-status.ongoing {
  background: rgba(47, 107, 255, 0.12);
  color: #2f6bff;
}
.m-status.ending {
  background: #fff0f1;
  color: #ff4d5a;
}
.m-status.ended {
  background: #f2f4f8;
  color: #b3bccd;
}

.m-prog {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}
.m-prog .prog-track {
  flex: 1;
  height: 12rpx;
  background: #e9eef7;
  border-radius: 8rpx;
  overflow: hidden;
}
.m-prog .prog-bar {
  height: 100%;
  background: linear-gradient(90deg, #4d86ff, #0fd083);
  border-radius: 8rpx;
  transition: width .5s ease;
}
.m-prog-txt {
  flex: none;
  margin-left: 18rpx;
  font-size: 20rpx;
  color: #7b8799;
}
.m-vfy {
  flex: none;
  margin-left: 14rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #b4620a;
  background: #fff7e8;
  border-radius: 20rpx;
  padding: 4rpx 14rpx;
}
.m-vfy.all {
  color: #06a86b;
  background: #e6f9f1;
}
.m-vfy.todo {
  cursor: pointer;
  box-shadow: 0 4rpx 10rpx rgba(180, 98, 10, 0.18);
}
.m-court {
  margin-top: 18rpx;
  align-self: flex-start;
  font-size: 26rpx;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(135deg, #06a86b, #0f9d6b);
  border-radius: 28rpx;
  padding: 14rpx 30rpx;
  box-shadow: 0 8rpx 18rpx rgba(6, 168, 107, 0.24);
}

.mini-foot {
  display: flex;
  justify-content: flex-end;
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 2rpx dashed #edf1f8;
}
.foot-action {
  font-size: 24rpx;
  border-radius: 34rpx;
  padding: 0 28rpx;
  line-height: 62rpx;
  height: 62rpx;
  margin-left: 16rpx;
}
.foot-action.enroll {
  color: #06a86b;
  background: #eefaf4;
}
.foot-action.cancel {
  color: #ff4d5a;
  background: #fff0f1;
}
.foot-action.del {
  color: #7b8799;
  background: #f0f2f7;
}
.foot-action.edit {
  color: #2f6bff;
  background: #eef4ff;
}
.foot-ok {
  font-size: 24rpx;
  color: #0fd083;
  font-weight: 600;
}
.foot-end {
  font-size: 24rpx;
  color: #9aa3b5;
  font-weight: 500;
  padding: 0 8rpx;
}
.foot-end.warn {
  color: #ff4d5a;
}

.mini-sk {
  height: 200rpx;
  margin-bottom: 22rpx;
  border-radius: 28rpx;
}

/* ---------- 卡片左滑操作 ---------- */
.swipe-hint {
  text-align: center;
  font-size: 20rpx;
  color: #9aa3b5;
  margin-bottom: 18rpx;
}
.swipe-cell {
  position: relative;
  margin-bottom: 22rpx;
}
.swipe-action {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 150rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 0 28rpx 28rpx 0;
  color: #fff;
  font-weight: 600;
}
.swipe-action.del {
  background: linear-gradient(160deg, #ff7a5c, #ff4d5a);
}
.swipe-action.cancel {
  background: linear-gradient(160deg, #ffb14d, #ff8a3d);
}
.swipe-ico {
  font-size: 40rpx;
  line-height: 1;
}
.swipe-txt {
  font-size: 22rpx;
  letter-spacing: 2rpx;
  margin-top: 6rpx;
}
/* 卡片浮在按钮之上；拖拽中关闭过渡实现跟手 */
.swipe-card {
  position: relative;
  margin-bottom: 0;
  transition: transform 0.26s cubic-bezier(0.2, 0.8, 0.3, 1);
  will-change: transform;
}
.swipe-card.dragging {
  transition: none;
}

/* ---------- 报名名单 ---------- */
.sheet-body {
  max-height: 60vh;
}
.enroll-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f2f5fa;
}
.enroll-item:last-child {
  border-bottom: none;
}
.enroll-no {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #eef4ff;
  color: #2f6bff;
  font-size: 20rpx;
  font-weight: 700;
  text-align: center;
  line-height: 36rpx;
  margin-right: 18rpx;
  flex: none;
}
.enroll-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  flex: none;
  overflow: hidden;
}
.enroll-avatar-img {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
}
.enroll-name {
  flex: 1;
  font-size: 28rpx;
  color: #16233c;
}
.enroll-time {
  font-size: 20rpx;
  color: #b3bccd;
  margin-left: 12rpx;
  flex: none;
}
.enroll-level {
  flex: none;
  font-size: 20rpx;
  font-weight: 600;
  color: #ef6c00;
  background: rgba(239,108,0,.1);
  border-radius: 16rpx;
  padding: 3rpx 12rpx;
  margin-left: 12rpx;
}
.enroll-level.none {
  color: #9aa3b5;
  background: #f2f4f8;
  font-weight: 400;
}
.enroll-item {
  cursor: pointer;
}
.enroll-vfy {
  flex: none;
  margin-left: 14rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #06a86b;
}
.enroll-vfy.todo {
  color: #9aa3b5;
  font-weight: 400;
}
.enroll-remark {
  flex-basis: 100%;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #5b6577;
  background: #f3f6fb;
  border-radius: 12rpx;
  padding: 8rpx 16rpx;
}

@keyframes blinkAnim {
  0%, 100% { opacity: 1; }
  50% { opacity: .3; }
}
