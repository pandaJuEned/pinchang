  display: flex;
  align-items: center;
  background: #f6f8fd;
  border: 2rpx solid #e6ecf8;
  border-radius: 40rpx;
  padding: 14rpx 22rpx;
  margin: 0 16rpx 16rpx 0;
  font-size: 25rpx;
  color: #5b6779;
  transition: all .2s ease;
}
.rp-chip.on {
  background: linear-gradient(135deg, #eaf2ff, #e6faf2);
  border-color: #2f6bff;
  color: #1d4ed8;
  font-weight: 600;
  box-shadow: 0 4rpx 14rpx rgba(47,107,255,.18);
}
.rp-chip.cus {
  background: #fff7e8;
  border-color: rgba(239,108,0,.3);
  color: #b4620a;
}
.remind-add {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}
.ra-label {
  font-size: 26rpx;
  color: #5b6779;
  flex: none;
}
.ra-input {
  flex: 1;
  height: 72rpx;
  margin: 0 16rpx;
  padding: 0 20rpx;
  background: #f6f8fd;
  border: 2rpx solid #e6ecf8;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #16233c;
}
.ra-add {
  flex: none;
  font-size: 26rpx;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(135deg, #4d86ff, #2f6bff);
  border-radius: 16rpx;
  padding: 16rpx 28rpx;
  box-shadow: 0 6rpx 16rpx rgba(47,107,255,.2);
}
.remind-sheet-tip {
  margin-top: 22rpx;
  font-size: 21rpx;
  color: #a3acbb;
  line-height: 1.5;
}
.remind-sheet-tip.sub {
  margin-top: 8rpx;
  color: #ff8a3d;
}
.remind-confirm {
  margin-top: 22rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(135deg, #4d86ff, #2f6bff);
  border-radius: 44rpx;
  box-shadow: 0 12rpx 26rpx rgba(47,107,255,.26);
}
.remind-confirm.loading {
  opacity: .6;
}
