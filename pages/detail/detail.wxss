}
.player-avatar {
  position: relative;
}
.enroll-remark {
  flex-basis: 100%;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #5b6577;
  background: #f3f6fb;
  border-radius: 12rpx;
  padding: 8rpx 16rpx;
}
.enroll-remark {
  flex-basis: 100%;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #5b6577;
  background: #f3f6fb;
  border-radius: 12rpx;
  padding: 8rpx 16rpx;
}

/* ---------- 开启球场 + 场地核销（合并） ---------- */
.court-bar {
  margin-top: 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #e9f7ef, #e6f0ff);
  border-radius: 18rpx;
  padding: 20rpx 24rpx;
}
.court-bar.done {
  background: linear-gradient(135deg, #e6f9f1, #e9f3ff);
}
.court-bar.expired {
  background: linear-gradient(135deg, #fff7e8, #ffeef0);
}
.court-main {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}
.court-title {
  display: flex;
  align-items: center;
}
.court-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #16233c;
}
.court-tag {
  font-size: 20rpx;
  font-weight: 600;
  color: #5b6577;
  background: #fff;
  border-radius: 16rpx;
  padding: 2rpx 14rpx;
  margin-left: 14rpx;
}
.court-tag.ok {
  color: #06a86b;
  background: #e6f9f1;
}
.court-tip {
  font-size: 22rpx;
  color: #5b6577;
  margin-top: 8rpx;
  line-height: 1.4;
}
.court-count {
  font-size: 22rpx;
  font-weight: 600;
  color: #0f9d6b;
  margin-top: 6rpx;
}
.court-bar.expired .court-count {
  color: #b4620a;
}
.court-bar.early .court-count {
  color: #2f6bff;
}
.court-btn {
  flex: none;
  font-size: 26rpx;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(135deg, #06a86b, #0f9d6b);
  border-radius: 28rpx;
  padding: 14rpx 30rpx;
  box-shadow: 0 8rpx 18rpx rgba(6, 168, 107, 0.24);
}
.court-btn.loading {
  opacity: 0.6;
}

/* ---------- 调整人数 ---------- */
.adj-card {
  padding: 32rpx;
  margin-bottom: 160rpx;
}
.sec-title {
  font-size: 30rpx;
  font-weight: 700;
