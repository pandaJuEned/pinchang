  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}
.foot-btn.primary {
  background: linear-gradient(135deg, #4d86ff 0%, #2f6bff 60%, #2458ea 100%);
  box-shadow: 0 12rpx 26rpx rgba(47, 107, 255, 0.28);
}
