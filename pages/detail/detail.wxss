  line-height: 1.4;
}

/* ---------- 名单弹层 ---------- */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.5);
  z-index: 900;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.25s ease, visibility 0.25s ease;
}
.mask.show {
  opacity: 1;
  visibility: visible;
}
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 20rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  z-index: 950;
  transform: translateY(100%);
  transition: transform 0.28s ease;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
}
.sheet.show {
  transform: translateY(0);
}
.sheet-bar {
  width: 76rpx;
  height: 8rpx;
  border-radius: 6rpx;
  background: #e2e8f2;
  margin: 0 auto 16rpx;
}
.sheet-title {
  font-size: 30rpx;
  font-weight: 700;
