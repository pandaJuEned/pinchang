}

/* ---------- 底部操作条 ---------- */
.foot-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -8rpx 24rpx rgba(31, 60, 120, 0.08);
  z-index: 90;
}
.foot-btn {
  height: 92rpx;
