/* ============ Court Buddy 全局样式 ============ */
/* 亮色底 + 运动蓝 / 活力绿 */
page {
  background: #f2f6fc;
  color: #16233c;
  font-size: 28rpx;
  line-height: 1.5;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Arial,
    'PingFang SC', 'Microsoft YaHei', sans-serif;
  -webkit-font-smoothing: antialiased;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx 200rpx;
}

.card {
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 10rpx 34rpx rgba(31, 60, 120, 0.07);
}

/* ---------- 文字溢出 ---------- */
.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ---------- 主要按钮 ---------- */
.primary-btn {
  background: linear-gradient(135deg, #4d86ff 0%, #2f6bff 60%, #2458ea 100%);
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  line-height: 96rpx;
  height: 96rpx;
  box-shadow: 0 12rpx 26rpx rgba(47, 107, 255, 0.28);
  letter-spacing: 2rpx;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.primary-btn::after {
  border: none;
}
.primary-btn-hover {
  transform: scale(0.98);
  box-shadow: 0 6rpx 14rpx rgba(47, 107, 255, 0.32);
}
.primary-btn.disabled {
  opacity: 0.55;
  box-shadow: none;
}
.green-btn {
  background: linear-gradient(135deg, #23e09d 0%, #0fd083 60%, #06b96f 100%);
  box-shadow: 0 12rpx 26rpx rgba(15, 208, 131, 0.26);
}
.danger-text {
  color: #ff4d5a;
}
.ghost-btn {
  background: #eef4ff;
  color: #2f6bff;
  border-radius: 40rpx;
  font-size: 28rpx;
  text-align: center;
  line-height: 80rpx;
  height: 80rpx;
}
.ghost-btn::after {
  border: none;
}

/* ---------- 输入框 ---------- */
.field-input {
  background: #f6f8fd;
  border: 2rpx solid transparent;
  border-radius: 20rpx;
  height: 92rpx;
  padding: 0 26rpx;
  font-size: 30rpx;
  color: #16233c;
  box-sizing: border-box;
  width: 100%;
}
.field-input.err {
  border-color: #ff4d5a;
  background: #fff5f6;
}
.err-tip {
  color: #ff4d5a;
  font-size: 24rpx;
  margin-top: 10rpx;
  display: flex;
  align-items: center;
}
.err-tip::before {
  content: '!';
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #ff4d5a;
  color: #fff;
  font-size: 20rpx;
  text-align: center;
  line-height: 28rpx;
  margin-right: 10rpx;
  flex: none;
}

/* ---------- 空状态 ---------- */
.empty {
  padding: 120rpx 40rpx;
  text-align: center;
}
.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.85;
}
.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #44506b;
}
.empty-sub {
  font-size: 26rpx;
  color: #9aa3b5;
  margin-top: 12rpx;
}
.empty-btn {
  margin-top: 40rpx;
}

/* ---------- 遮罩 & 底部弹层 ---------- */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 25, 50, 0.5);
  z-index: 90;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.22s ease, visibility 0.22s;
}
.mask.show {
  opacity: 1;
  visibility: visible;
}
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 36rpx 36rpx 0 0;
  z-index: 99;
  transform: translateY(110%);
  transition: transform 0.26s cubic-bezier(0.2, 0.8, 0.3, 1);
  max-height: 76vh;
  display: flex;
  flex-direction: column;
}
.sheet.show {
  transform: translateY(0);
}
.sheet-bar {
  width: 72rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: #dfe4ee;
  margin: 18rpx auto 6rpx;
}
.sheet-title {
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  padding: 12rpx 0 20rpx;
  position: relative;
}
.sheet-close {
  position: absolute;
  right: 30rpx;
  top: 8rpx;
  color: #9aa3b5;
  font-size: 34rpx;
  padding: 6rpx;
}
.sheet-body {
  overflow-y: auto;
  padding: 0 36rpx 36rpx;
}

/* ---------- 动画 ---------- */
@keyframes shakeAnim {
  0%, 100% { transform: translateX(0); }
  20% { transform: translateX(-12rpx); }
  40% { transform: translateX(12rpx); }
  60% { transform: translateX(-8rpx); }
  80% { transform: translateX(8rpx); }
}
.shake {
  animation: shakeAnim 0.42s ease;
}

@keyframes breathAnim {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.07); }
}
.icon-breathe {
  animation: breathAnim 2.6s ease-in-out infinite;
}

@keyframes shimmerAnim {
  0% { background-position: -600rpx 0; }
  100% { background-position: 600rpx 0; }
}
.skeleton-block {
  border-radius: 20rpx;
  background: linear-gradient(90deg, #e9eef7 25%, #f5f8fd 45%, #e9eef7 65%);
  background-size: 1200rpx 100%;
  animation: shimmerAnim 1.4s linear infinite;
}

@keyframes popNum {
  0% { transform: scale(1.55); }
  100% { transform: scale(1); }
}
.num-pop {
  animation: popNum 0.42s ease;
}

@keyframes riseIn {
  from { opacity: 0; transform: translateY(30rpx); }
  to { opacity: 1; transform: translateY(0); }
}
.rise-in {
  animation: riseIn 0.34s ease both;
}
