<view class="tab-bar">
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="tab-item {{selected === index ? 'active' : ''}}"
    data-index="{{index}}"
    data-path="{{item.pagePath}}"
    bindtap="switchTab"
  >
    <view class="tab-text">{{item.text}}</view>
    <view class="tab-dot" wx:if="{{selected === index}}"></view>
  </view>
</view>
